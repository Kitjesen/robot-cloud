# Installation gate. Enabling it alone does not authorize a cloud connection.
DOSO_CLOUD_ON=false
# Requires a protected regular file containing exactly true or true plus LF.
# Missing/invalid/false stops the connection; runtime checks at most 250ms apart.
# The trusted local owner-authorization writer is not implemented yet.
DOSO_CLOUD_CHOICE=/var/lib/doso-cloud/choice
DOSO_DEVICE_ID=00000000-0000-4000-8000-000000000001
DOSO_MQTT_URL=mqtts://8.153.169.177:8883
DOSO_MQTT_CA=/etc/doso/robot-cloud/agent/ca.crt
DOSO_MQTT_CERT=/etc/doso/robot-cloud/agent/device.crt
DOSO_MQTT_KEY=/etc/doso/robot-cloud/agent/device.key
DOSO_DEVICE_SIGNING_KEY=/etc/doso/robot-cloud/agent/device-signing.key
DOSO_GATEWAY_PUBLIC_KEY=/etc/doso/robot-cloud/agent/gateway-signing.pub
# Existing GNSS owner's atomic snapshot. Missing/expired fix omits location.
DOSO_GNSS_STATUS=/dev/shm/lingtu/gnss_status.json
# Optional protected local JSON with an absolute program and argument array.
# The program must directly own the encoder process; no cloud command is executed.
# DOSO_VIDEO_CONFIG=/etc/doso/robot-cloud/video.json

# Separate control-mode process: doso-cloud-link control.
# DOSO_CONTROL_URL=https://control.example.com
# DOSO_CONTROL_CA=/etc/doso/robot-cloud/agent/control-ca.pem
# DOSO_CONTROL_LOCAL_ENDPOINT=https://localhost:5052
# DOSO_CONTROL_LOCAL_API_KEY=
# DOSO_CONTROL_LOCAL_CA=/etc/doso/robot-cloud/agent/local-sdk-ca.pem
