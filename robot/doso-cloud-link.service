[Unit]
Description=DOSO robot read-only cloud link
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=doso-cloud
Group=doso-cloud
WorkingDirectory=/opt/doso
EnvironmentFile=/etc/doso/robot-cloud/agent/agent.env
ExecStart=/opt/doso/bin/doso-cloud-link
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
