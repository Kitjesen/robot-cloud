DOSO_MQTT_URL=mqtts://mqtt.example.com:8883
DOSO_MQTT_CA=/etc/doso/robot-cloud/gateway/ca.crt
DOSO_MQTT_CERT=/etc/doso/robot-cloud/gateway/client.crt
DOSO_MQTT_KEY=/etc/doso/robot-cloud/gateway/client.key
DOSO_MQTT_CLIENT_ID=doso-gateway
DOSO_GATEWAY_SIGNING_KEY=/etc/doso/robot-cloud/gateway/signing.key
DOSO_DEVICE_REGISTRY=/etc/doso/robot-cloud/gateway/devices.json
DOSO_REPORTING_STATE=/var/lib/doso-cloud/reporting.json
DOSO_GATEWAY_PORT=8130
# Generate outside source control; this credential is for the existing backend only.
DOSO_GATEWAY_API_KEY=
# Set both to enable automatic business sync; use a dedicated named service key.
# DOSO_REMOTE_SYNC_URL=https://project.supabase.co/functions/v1/remote-state-sync
# DOSO_REMOTE_SYNC_KEY=
