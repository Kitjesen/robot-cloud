diff --git a/ui-ngx/src/scss/doso.scss b/ui-ngx/src/scss/doso.scss
new file mode 100644
index 0000000..8e15578
--- /dev/null
+++ b/ui-ngx/src/scss/doso.scss
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 DOSO. Product presentation over the existing ThingsBoard components.
+@font-face {
+  font-family: 'MiSans';
+  src: url('/assets/fonts/MiSans-Regular.otf') format('opentype');
+  font-style: normal;
+  font-weight: 400;
+  font-display: swap;
+}
+
+@font-face {
+  font-family: 'MiSans';
+  src: url('/assets/fonts/MiSans-Medium.otf') format('opentype');
+  font-style: normal;
+  font-weight: 500;
+  font-display: swap;
+}
+
+@font-face {
+  font-family: 'MiSans';
+  src: url('/assets/fonts/MiSans-Demibold.otf') format('opentype');
+  font-style: normal;
+  font-weight: 600;
+  font-display: swap;
+}
+
+@font-face {
+  font-family: 'MiSans';
+  src: url('/assets/fonts/MiSans-Bold.otf') format('opentype');
+  font-style: normal;
+  font-weight: 700;
+  font-display: swap;
+}
+
+body.tb-default {
+  color: #253441;
+  background: #f4f7fa;
+  --mat-app-background-color: #f4f7fa;
+  --mat-app-text-color: #253441;
+  --mat-table-background-color: #fff;
+  --mat-table-row-item-outline-color: #edf0f5;
+  --tb-hover-color: #f5f9ff;
+}
+body, button, html, input, select, textarea, td, th {
+  font-family: $tb-font-family;
+}
+tb-home {
+  .tb-site-sidenav { border-right: 1px solid #e2e8ef; background: #fff; }
+  .tb-nav-header-toolbar.mat-primary,
+  .tb-side-menu-toolbar.mat-primary,
+  .tb-primary-toolbar.mat-primary { color: #253441; background: #fff; }
+  .tb-primary-toolbar { border-bottom: 1px solid #e2e8ef; }
+  .tb-primary-toolbar .mat-icon,
+  .tb-primary-toolbar tb-icon,
+  .tb-primary-toolbar .tb-user-info { color: #586675; }
+  .tb-main-content { background: #f4f7fa; }
+  tb-side-menu { padding: 16px 12px; }
+  .tb-side-menu > li { border-bottom: none; margin-bottom: 5px; }
+  .tb-side-menu a.mat-mdc-button.mat-mdc-button-base {
+    color: #586675;
+    --mdc-text-button-label-text-color: #586675;
+    height: 44px;
+    border-radius: 8px;
+    padding: 0 12px;
+    font-weight: 500;
+    letter-spacing: 0;
+    transition: background-color 140ms, color 140ms;
+  }
+  .tb-side-menu a.mat-mdc-button.mat-mdc-button-base:hover { color: #1f4d7a; background: #f4f7fb; }
+  .tb-side-menu a.mat-mdc-button.mat-mdc-button-base.tb-active { color: #0066ff; background: #eaf2ff; }
+  .tb-side-menu a .mat-icon { color: inherit; }
+  .tb-menu-toggle-list a.mat-mdc-button.mat-mdc-button-base { padding-left: 24px; }
+  .tb-side-menu .tb-toggle-icon { font-size: 10px; color: #94a0ae; }
+  .mat-mdc-table-toolbar { background: #fff; }
+  tb-entities-table { padding: 24px; box-sizing: border-box; }
+  tb-entities-table .mat-mdc-table-container { border: 1px solid #e2e8ef; border-radius: 0 0 12px 12px; background: #fff; }
+  tb-entities-table .mat-mdc-table-toolbar { border: 1px solid #e2e8ef; border-bottom: 0; border-radius: 12px 12px 0 0; min-height: 76px; }
+  tb-entities-table .mat-mdc-header-cell { color: #7b8796; font-weight: 500; background: #fbfcfe; font-size: 12px; }
+  tb-entities-table .mat-mdc-cell { color: #253441; font-size: 13px; }
+  tb-entities-table .mat-mdc-row { height: 64px; }
+  tb-entities-table .mat-column-name { min-width: 180px; max-width: 280px; }
+  tb-entities-table .mat-column-label { min-width: 150px; }
+  tb-entities-table .mat-column-dosoSource { white-space: nowrap; color: #68798b; }
+}
+body.tb-default .mat-mdc-unelevated-button,
+body.tb-default .mat-mdc-raised-button,
+body.tb-default .mat-mdc-outlined-button { border-radius: 8px; }
+body.tb-default a:focus-visible,
+body.tb-default button:focus-visible { outline: 2px solid #0066ff; outline-offset: 3px; }
+@media (max-width: 959px) { tb-home tb-entities-table { padding: 16px; } }
+@media (max-width: 599px) { tb-home tb-entities-table { padding: 8px; } }
+@media (prefers-reduced-motion: reduce) { tb-home .tb-side-menu a.mat-mdc-button.mat-mdc-button-base { transition: none; } }
