# Device metadata is read by the updater at startup; do not copy demo values to a robot.
DOSO_DEVICE_ID=
DOSO_MODEL=
DOSO_HARDWARE_REVISION=
DOSO_BOOTLOADER_VERSION=
DOSO_BRAINSTEM_VERSION=
DOSO_BRAINSTEM_RELEASE=
DOSO_BATTERY_PERCENT=100

# The device-installed Ed25519 release verification key. This is a public key.
DOSO_OTA_VERIFY_KEY=/etc/doso/robot-cloud/ota/release-signing.pub.pem
DOSO_DEVICE_ONLINE=false
DOSO_TASK_RUNNING=false
DOSO_OTA_ROOT=/var/lib/doso-ota
DOSO_OTA_STAGING_DIR=/ota/staging
DOSO_OTA_RELEASES_DIR=/opt/doso/releases
DOSO_OTA_CURRENT_LINK=/opt/doso/current
DOSO_OTA_LAST_GOOD_LINK=/opt/doso/last-known-good
# Multi-component independent slots & automatic release garbage collection.
# DOSO_OTA_COMPONENTS_ROOT=/opt/doso/components
# DOSO_OTA_KEEP_HISTORY=2
# DOSO_OTA_UNIT=doso-ota.service
DOSO_OTA_BIND=127.0.0.1:13147
DOSO_OTA_TOKEN=
DOSO_BRAINSTEM_UNIT=doso-brainstem.service

# Channel A health verification (:5054/health JSON or Ed25519-signed envelope when verify key is set).
DOSO_OTA_BOOT_ID=/run/doso/brainstem.boot_id
DOSO_OTA_BRAINSTEM_HEALTH_URL=http://127.0.0.1:5054/health
# Real-robot safety defaults: do not require CAN read-only; gate restarts on grounded + motors off + Vbus >= 44V.
# DOSO_OTA_REQUIRE_CAN_READ_ONLY=false
# DOSO_OTA_MIN_VBUS_V=44.0
# Optional: enable Ed25519 health proof + diagnostic marker files if deployed.
# DOSO_OTA_HEALTH_VERIFY_KEY=/etc/doso/robot-cloud/ota/brainstem-health.pub.pem
# DOSO_OTA_STRATEGY_MARKER=/run/doso/strategy.ready
# DOSO_OTA_CAN_MARKER=/run/doso/can.readonly.ok

# Channel B zero-restart policy hot-OTA (:5054/v1/policies/{push,rollback}).
DOSO_POLICY_ADMIN_URL=http://127.0.0.1:5054
# DOSO_POLICY_ADMIN_TOKEN=

# Optional autonomous cloud polling against Shanghai doso-ota-release (:8140 behind HTTPS).
# DOSO_OTA_CLOUD_URL=https://api-test.dosorobotics.com/ota
# DOSO_OTA_CLOUD_TOKEN=
# DOSO_OTA_POLL_INTERVAL_SECS=15
